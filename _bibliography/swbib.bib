@incollection{WalS2011,
	author={Walter, Scott A.},
	title={{Henri Poincar\'e, theoretical physics and relativity theory in Paris}},
	booktitle={{Mathematics Meets Physics: A Contribution to Their Interaction in the 19th and the First Half of the 20th Century}},
	editor={Schlote, Karl-Heinz and Schneider, Martina},
	publisher={Harri Deutsch},
